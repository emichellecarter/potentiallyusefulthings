# Authenticate to Azure Subscription
$ghUsername               = 'mcarter106'
$ghPAT                    = ''
$ghOrgName                = 'fed-test-org'

$subscriptionId = (Get-AzContext).Subscription.Id
$tenantId = (Get-AzContext).Tenant.Id

$servicePrincipalList = @{
  'sp-1' = @{
      repolist = @{
          'repo-1' = @(
              @{
                  secretType  = 'pull_request' #sbx
              }
          )
          'repo-2' = @(
              @{
                  secretType  = 'pull_request' #sbx
              } 
          )
      }
  }
  'sp-2' = @{
      repolist = @{
          'repo-1' = @(
              @{
                  secretType  = 'branch' #dev
                  branch = 'main'
              }
          )
          'repo-2' = @(
              @{
                  secretType  = 'branch' #dev
                  branch = 'main'
              }
          )
      }
  }
  'sp-3' = @{
      repolist = @{
          'repo-1' = @(
              @{
                  secretType  = 'environment' #prod
                  environmentName = 'prodenv' #needs updating
              }
          )
          'repo-2' = @(
              @{
                  secretType  = 'environment' #prod
                  environmentName = 'prodenv'
              }
          )
      }
  }
}
foreach ($sp in $servicePrincipalList.GetEnumerator())
{
  $spName = $sp.Key
  foreach ($repo in $sp.value.repolist.GetEnumerator())
  {
      $repoName = $repo.Key
      foreach ($secret in $repo.Value)
      {
          $tf_sp_name = $spname
          $ghRepoName = $($reponame)
          $fed_subject_type = $($secret.secretType)
          $ghBranchName = $($secret.branch)
          $ghRepoEnvironmentName = $($secret.environmentName)


################################### Assign the federated Credential Subject ###########################

if ( $fed_subject_type -eq "environment")
{
  $fedSubject            = "repo:$ghOrgName/${ghRepoName}:environment:$ghRepoEnvironmentName"
  $fedName               = "$tf_sp_name-$ghOrgName-$ghRepoName-$ghRepoEnvironmentName"
}

if ( $fed_subject_type -eq "pull_request")
{
  $fedSubject   = "repo:$ghOrgName/${ghRepoName}:pull_request"
  $fedName      = "$tf_sp_name-$ghOrgName-$ghRepoName"
}

if ( $fed_subject_type -eq "branch")
{
  $fedSubject  = "repo:$ghOrgName/${ghRepoName}:ref:refs/heads/${ghBranchName}"
  $fedName = "$tf_sp_name-$ghOrgName-$ghRepoName-$ghBranchName"
}


####################### CREATE SERVICE PRINCIPAL AND FEDERATED CREDENTIAL #######################

if (-Not ($sp = Get-AzADServicePrincipal -DisplayName $tf_sp_name -ErrorAction 'SilentlyContinue'))
{
  $sp = New-AzADServicePrincipal -DisplayName $tf_sp_name -ErrorAction 'Stop'
}

$app = Get-AzADApplication -ApplicationId $sp.AppId

if (-Not (Get-AzADAppFederatedCredential -ApplicationObjectId $app.Id -Filter "(Subject eq '$fedSubject')" -ErrorAction 'SilentlyContinue'))
{
  $params = @{
      ApplicationObjectId = $app.Id
      Audience            = 'api://AzureADTokenExchange'
      Issuer              = 'https://token.actions.githubusercontent.com'
      Name                = "$fedName"
      Subject             = "$fedSubject" 
  }
  $cred = New-AzADAppFederatedCredential @params
}

####################### CREATE BACKEND RESOURCES ####################### 
